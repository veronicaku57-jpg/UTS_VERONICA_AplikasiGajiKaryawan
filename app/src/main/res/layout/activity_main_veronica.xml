<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8FAFC"
    android:padding="20dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="GAJI KARYAWAN"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:gravity="center"
        android:background="#1E293B"
        android:padding="16dp"
        android:layout_marginBottom="32dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:id="@+id/btnGaji"
            android:layout_width="0dp"
            android:layout_height="120dp"
            android:layout_weight="1"
            android:layout_marginRight="8dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="#FFFFFF"
            android:clickable="true"
            android:focusable="true"
            android:elevation="2dp"
            android:padding="12dp">

            <View
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="#3B82F6" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gaji Pegawai"
                android:textColor="#334155"
                android:textStyle="bold"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnPetunjuk"
            android:layout_width="0dp"
            android:layout_height="120dp"
            android:layout_weight="1"
            android:layout_marginLeft="8dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="#FFFFFF"
            android:clickable="true"
            android:focusable="true"
            android:elevation="2dp"
            android:padding="12dp">

            <View
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="#10B981" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Petunjuk"
                android:textColor="#334155"
                android:textStyle="bold"
                android:layout_marginTop="8dp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="32dp">

        <LinearLayout
            android:id="@+id/btnTentang"
            android:layout_width="0dp"
            android:layout_height="120dp"
            android:layout_weight="1"
            android:layout_marginRight="8dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="#FFFFFF"
            android:clickable="true"
            android:focusable="true"
            android:elevation="2dp"
            android:padding="12dp">

            <View
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="#F59E0B" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tentang"
                android:textColor="#334155"
                android:textStyle="bold"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnExit"
            android:layout_width="0dp"
            android:layout_height="120dp"
            android:layout_weight="1"
            android:layout_marginLeft="8dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="#FFFFFF"
            android:clickable="true"
            android:focusable="true"
            android:elevation="2dp"
            android:padding="12dp">

            <View
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="#EF4444" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Exit"
                android:textColor="#334155"
                android:textStyle="bold"
                android:layout_marginTop="8dp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="www.veronica.com"
        android:textColor="#2196F3"
        android:gravity="center"
        android:background="#E2E8F0"
        android:padding="12dp"
        android:layout_marginTop="40dp" />

</LinearLayout>